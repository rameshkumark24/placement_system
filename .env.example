# ---- Local Docker Compose ----
MYSQL_HOST_PORT=3307

# ---- Database ----
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/placement_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
# Optional connection-pool tuning (use 2 / 0 / 10000 / 30000 on Clever Cloud's dev plan)
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# ---- Security ----
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=placementSystemJwtSecretKey2026SecureKey123!
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# First admin account, created on startup if it does not exist (password: 8+ characters)
APP_ADMIN_EMAIL=admin@placement.local
APP_ADMIN_PASSWORD=ChangeMe123!
APP_ADMIN_NAME=Placement Admin

# ---- Rate limiting (requests per client IP) ----
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_DURATION_MINUTES=1
RATE_LIMIT_AUTH_CAPACITY=20

# ---- CORS (comma-separated, no trailing slash; patterns like https://*.vercel.app allowed) ----
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# ---- Server ----
# PORT=8080
